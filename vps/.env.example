# Copie para .env e preencha. Este arquivo vai para o git; o .env não.

# Painel (usuário + hash bcrypt de `docker compose run --rm caddy caddy hash-password`)
PAINEL_USUARIO=admin
PAINEL_HASH=

# Token do agente do PC (o mesmo que fica em secrets/agente.json no PC)
AGENTE_TOKEN=

# Avisos: tópico e token de publicação do ntfy (`ntfy token add <usuario>`)
NTFY_TOPICO=casa
NTFY_TOKEN=

# Claude: chave da API (você mesmo coloca) e modelos
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5

# Retenção das fotos de eventos (dias)
RETENCAO_DIAS=30
