+// StartPlayback sends MISS_CMD_PLAYBACK_REQ (0x10D) to play the camera's SD card recording (patch casa).
+// Format taken from the Xiaomi Home app (SDCardPlayerActivity.setPlayTime): every field is an int and the
+// times are unix seconds. With autoswitchtolive the camera switches to live once playback reaches "now".
+func (c *Client) StartPlayback(start, end int64, speed int, toLive bool) error {
+	live := 0
+	if toLive {
+		live = 1
+	}
+	data := binary.BigEndian.AppendUint32(nil, cmdPlaybackReq)
+	data = fmt.Appendf(data, `{"sessionid":%d,"starttime":%d,"endtime":%d,"autoswitchtolive":%d,"offset":0,"speed":%d,"avchannelmerge":0}`,
+		time.Now().Unix()&0x7fffffff, start, end, live, speed)
+	if err := c.WriteCommand(data); err != nil {
+		return err
+	}
+	// the camera answers on the command channel (PLAYBACK_RESP); log every answer (no deadline: it would
+	// kill the shared UDP reader)
+	go func() {
+		for {
+			cmd, res, err := c.Conn.ReadCommand()
+			if err != nil {
+				return
+			}
+			if cmd == cmdEncoded || cmd == 0x01100000 { // ReadCommand is little endian, cmdEncoded goes big endian
+				if dec, err2 := crypto.Decode(res, c.key); err2 == nil {
+					res = dec
+				}
+			}
+			fmt.Fprintf(os.Stderr, "miss: playback command answer cmd=0x%X data=%q\n", cmd, res)
+		}
+	}()
+	return nil
+}
