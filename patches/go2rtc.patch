diff --git a/pkg/xiaomi/miss/cs2/internet.go b/pkg/xiaomi/miss/cs2/internet.go
new file mode 100644
index 0000000..017249d
--- /dev/null
+++ b/pkg/xiaomi/miss/cs2/internet.go
@@ -0,0 +1,218 @@
+package cs2
+
+// Modo internet do CS2 (PPPP), como o app Xiaomi faz quando a câmera não está na mesma rede: formatos tirados da
+// libPPCS_API.so do app (símbolos cs2p2p_PPPP_Proto_*). A nuvem (miss_get_vendor) dá o p2p_id e a init_string.
+//
+//	HELLO (F1 00) e P2P_REQ (F1 20: DID + nosso endereço local) -> servidores CS2, UDP 32100
+//	servidor -> P2P_REQ_ACK (F1 21) e PUNCH_TO (F1 40: endereços da câmera, público e local)
+//	PUNCH_PKT (F1 41: DID) para esses endereços até a câmera responder P2P_RDY (F1 42)
+//
+// Depois disso a sessão é igual à da rede local (DRW). Testado em 03/11 do PC de casa até a câmera do rancho
+// (NAT do modem): P2P_RDY em 0,65 s.
+
+import (
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"net"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const (
+	msgHello      = 0x00
+	msgHelloAck   = 0x01
+	msgP2PReq     = 0x20
+	msgP2PReqAck  = 0x21
+	msgPunchTo    = 0x40
+	serverPortCS2 = 32100
+)
+
+// initKey: tabela de 54 bytes da cs2p2p_PPPP_DecodeString (libPPCS_API.so, 0x10fc09).
+var initKey = []byte{
+	0x49, 0x59, 0x43, 0x3d, 0xb5, 0xbf, 0x6d, 0xa3, 0x47, 0x53, 0x4f, 0x61, 0x65, 0xe3, 0x71, 0xe9,
+	0x67, 0x7f, 0x02, 0x03, 0x0b, 0xad, 0xb3, 0x89, 0x2b, 0x2f, 0x35, 0xc1, 0x6b, 0x8b, 0x95, 0x97,
+	0x11, 0xe5, 0xa7, 0x0d, 0xef, 0xf1, 0x05, 0x07, 0x83, 0xfb, 0x9d, 0x3b, 0xc5, 0xc7, 0x13, 0x17,
+	0x1d, 0x1f, 0x25, 0x29, 0xd3, 0xdf,
+}
+
+// DecodeInitString devolve a lista de servidores P2P ("ip1,ip2,ip3,") da init_string.
+func DecodeInitString(s string) []string {
+	if i := strings.IndexByte(s, ':'); i >= 0 {
+		s = s[:i] // depois do ':' viria a chave P2P (as das câmeras Xiaomi não têm)
+	}
+	out := make([]byte, 0, len(s)/2)
+	for i := 0; i < len(s)/2; i++ {
+		x := byte(0x39)
+		for _, b := range out {
+			x ^= b
+		}
+		out = append(out, initKey[i%len(initKey)]^x^(16*s[2*i]+s[2*i+1]+0xAF))
+	}
+	var servers []string
+	for _, h := range strings.Split(strings.TrimRight(string(out), "\x00"), ",") {
+		if h = strings.TrimSpace(h); h != "" {
+			servers = append(servers, h)
+		}
+	}
+	return servers
+}
+
+// didBytes: prefixo (8 bytes) + série (u32 big endian) + código de verificação (8 bytes).
+func didBytes(did string) ([]byte, error) {
+	p := strings.Split(did, "-")
+	if len(p) != 3 {
+		return nil, errors.New("cs2: p2p_id inválido")
+	}
+	sn, err := strconv.ParseUint(p[1], 10, 32)
+	if err != nil {
+		return nil, errors.New("cs2: p2p_id inválido")
+	}
+	b := make([]byte, 20)
+	copy(b[:7], p[0])
+	binary.BigEndian.PutUint32(b[8:], uint32(sn))
+	copy(b[12:19], p[2])
+	return b, nil
+}
+
+// sockaddr como a lib grava: família big endian, porta e IP com os bytes ao contrário da ordem de rede.
+func putSockaddr(b []byte, addr *net.UDPAddr) {
+	binary.BigEndian.PutUint16(b, 2)
+	binary.LittleEndian.PutUint16(b[2:], uint16(addr.Port))
+	ip := addr.IP.To4()
+	b[4], b[5], b[6], b[7] = ip[3], ip[2], ip[1], ip[0]
+}
+
+func readSockaddr(b []byte) *net.UDPAddr {
+	return &net.UDPAddr{IP: net.IPv4(b[7], b[6], b[5], b[4]), Port: int(binary.LittleEndian.Uint16(b[2:]))}
+}
+
+func cs2Msg(typ byte, body []byte) []byte {
+	b := make([]byte, 4+len(body))
+	b[0], b[1] = magic, typ
+	binary.BigEndian.PutUint16(b[2:], uint16(len(body)))
+	copy(b[4:], body)
+	return b
+}
+
+// DialP2P é o Dial com o plano B pela internet. mode: "" = rede local e, se falhar e houver p2p_id/init_string,
+// pela internet; "lan" = só rede local; "internet" = só pelos servidores (câmera em outra rede de propósito).
+func DialP2P(host, transport, did, initString, mode string) (*Conn, error) {
+	var conn net.Conn
+	var err error
+	if mode != "internet" {
+		conn, err = handshake(host, transport)
+	}
+	if mode == "internet" || (err != nil && mode != "lan" && did != "" && initString != "") {
+		var errLAN = err
+		if conn, err = handshakeInternet(did, initString, 15*time.Second); err != nil && errLAN != nil {
+			err = fmt.Errorf("%w (rede local: %v)", err, errLAN)
+		}
+	}
+	if err != nil {
+		return nil, err
+	}
+	return newConn(conn), nil
+}
+
+// handshakeInternet faz a sessão pelos servidores CS2 e devolve a conexão já apontada para o endereço da câmera
+// que respondeu P2P_RDY. Só UDP (o P2P_RDY_TCP da rede local não existe aqui).
+func handshakeInternet(did, initString string, timeout time.Duration) (net.Conn, error) {
+	servers := DecodeInitString(initString)
+	if len(servers) == 0 {
+		return nil, errors.New("cs2: init_string sem servidores")
+	}
+	id, err := didBytes(did)
+	if err != nil {
+		return nil, err
+	}
+
+	conn, err := net.ListenUDP("udp4", nil)
+	if err != nil {
+		return nil, err
+	}
+
+	var srvAddrs []*net.UDPAddr
+	for _, s := range servers {
+		if a, err := net.ResolveUDPAddr("udp4", net.JoinHostPort(s, strconv.Itoa(serverPortCS2))); err == nil {
+			srvAddrs = append(srvAddrs, a)
+		}
+	}
+	if len(srvAddrs) == 0 {
+		_ = conn.Close()
+		return nil, errors.New("cs2: nenhum servidor P2P resolvido")
+	}
+
+	// endereço local que vai no P2P_REQ: o IP da rota até o 1º servidor e a porta do nosso socket
+	local := &net.UDPAddr{IP: net.IPv4zero, Port: conn.LocalAddr().(*net.UDPAddr).Port}
+	if c, err := net.DialUDP("udp4", nil, srvAddrs[0]); err == nil {
+		local.IP = c.LocalAddr().(*net.UDPAddr).IP
+		_ = c.Close()
+	}
+	req := make([]byte, 36)
+	copy(req, id)
+	putSockaddr(req[20:], local)
+	hello, p2pReq, punch := cs2Msg(msgHello, nil), cs2Msg(msgP2PReq, req), cs2Msg(msgPunchPkt, id)
+
+	deadline := time.Now().Add(timeout)
+	var punchTo []*net.UDPAddr
+	var lastReq time.Time
+	buf := make([]byte, 1500)
+
+	for time.Now().Before(deadline) {
+		if time.Since(lastReq) > 2*time.Second {
+			lastReq = time.Now()
+			for _, a := range srvAddrs {
+				_, _ = conn.WriteToUDP(hello, a)
+				_, _ = conn.WriteToUDP(p2pReq, a)
+			}
+		}
+		for _, a := range punchTo {
+			// porta ±3 também: alguns NATs dão porta vizinha à que o servidor viu
+			for d := -3; d <= 3; d++ {
+				if p := a.Port + d; p > 0 && p < 65536 {
+					_, _ = conn.WriteToUDP(punch, &net.UDPAddr{IP: a.IP, Port: p})
+				}
+			}
+		}
+
+		_ = conn.SetReadDeadline(time.Now().Add(100 * time.Millisecond))
+		for {
+			n, from, err := conn.ReadFromUDP(buf)
+			if err != nil {
+				break // timeout curto: volta a mandar os punches
+			}
+			if n < 4 || buf[0] != magic {
+				continue
+			}
+			switch body := buf[4:n]; buf[1] {
+			case msgPunchTo:
+				if len(body) >= 8 {
+					a := readSockaddr(body)
+					novo := true
+					for _, p := range punchTo {
+						if p.IP.Equal(a.IP) && p.Port == a.Port {
+							novo = false
+						}
+					}
+					if novo {
+						punchTo = append(punchTo, a)
+					}
+				}
+			case msgPunchPkt:
+				// a câmera também fura o NAT na nossa direção: responder acelera o P2P_RDY
+				_, _ = conn.WriteToUDP(cs2Msg(msgP2PRdyUDP, id), from)
+			case msgP2PRdyUDP:
+				_ = conn.SetReadDeadline(time.Time{})
+				return &udpConn{UDPConn: conn, addr: from}, nil
+			}
+		}
+	}
+
+	_ = conn.Close()
+	if len(punchTo) == 0 {
+		return nil, errors.New("cs2: internet: os servidores P2P não deram o endereço da câmera (offline?)")
+	}
+	return nil, errors.New("cs2: internet: a câmera não respondeu ao punch")
+}
