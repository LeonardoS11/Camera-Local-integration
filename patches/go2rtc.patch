+package main
+
+// Ponte do rancho (celular Android + Termux): o binário linux/arm é estático (CGO_ENABLED=0) e o
+// resolvedor do Go lê /etc/resolv.conf, que não existe no Android -> sem DNS (api.io.mi.com falha).
+// Sem esse arquivo, usa o DNS de GO2RTC_DNS (padrão 1.1.1.1:53). No PC/VPS nada muda.
+
+import (
+	"context"
+	"net"
+	"os"
+	"time"
+)
+
+func init() {
+	if _, err := os.Stat("/etc/resolv.conf"); err == nil {
+		return
+	}
+	srv := os.Getenv("GO2RTC_DNS")
+	if srv == "" {
+		srv = "1.1.1.1:53"
+	}
+	d := net.Dialer{Timeout: 5 * time.Second}
+	net.DefaultResolver = &net.Resolver{PreferGo: true, Dial: func(ctx context.Context, network, _ string) (net.Conn, error) {
+		return d.DialContext(ctx, network, srv)
+	}}
+}
